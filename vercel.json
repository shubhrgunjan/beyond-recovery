{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    { "source": "/lab", "destination": "https://volt-hitting-strategy-reflected.trycloudflare.com", "permanent": false }
  ],
  "rewrites": [
    { "source": "/assets/research-report.html", "destination": "/report/index.html" },
    { "source": "/assets/:path*", "destination": "/report/:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
